# ---------------------------------------------------------------------------
# Set ONE of these. Gemini has a free tier that covers Flash and Flash-Lite
# including image input, which is enough to develop and rehearse the whole
# pipeline at zero cost.
# ---------------------------------------------------------------------------
# OpenRouter is the simplest: one key, every provider, pass-through token
# rates, and no cloud-project step. openrouter.ai/keys
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Two roles, two economics.
#   extraction is vision-heavy and expensive (~26k in / 15k out per pass, and
#   66% of the input is image tokens). It is schema-constrained, so a cheap
#   model has little room to go wrong.
#   the analyst is what the interviewer watches, and it is cheap per question.
# Run extraction on something free; spend on the analyst.
# Recommended: everything through OpenRouter.
#   GLM-4.6V for extraction  -- $0.30/$0.90 per 1M, native vision, built for
#                               dense page layouts. ~2 cents per full pass.
#   a stronger model for the analyst, because that is the half anyone watches.
# Whole project comes in around $1. Check exact model ids at openrouter.ai/models.
LLM_PROVIDER=openrouter              # auto | openrouter | anthropic | openai | gemini
LLM_PROVIDER_ANALYST=openrouter      # blank = same as LLM_PROVIDER
OPENROUTER_EXTRACT_MODEL=z-ai/glm-4.6v
OPENROUTER_ANALYST_MODEL=anthropic/claude-sonnet-5

# fixture : replay known-good output, no key needed at all
# record  : call the model AND save what it returned  <- do this once
# replay  : return that recorded run verbatim         <- demo on this
# model   : call the model live every time
EXTRACTOR=fixture

# A product decision, not a hyperparameter. Tune it until the queue is short
# enough that a human actually reads it.
REVIEW_THRESHOLD=0.82

COST_OF_CAPITAL_PCT=9.0
MAX_VENDORS_IN_SPLIT=3
