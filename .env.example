# One of these. config.py picks the LLMClient implementation from whichever is set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Which implementation of each seam is live. See README "Swappable by construction".
LLM_PROVIDER=anthropic      # anthropic | openai
ALLOCATOR=subsets           # naive | subsets | milp
ANALYST=toolloop            # toolloop | langgraph

# Extraction confidence below this routes the cell to the human review queue.
# This is a product decision, not a hyperparameter: tune it until the queue is
# short enough that a human actually reads it.
REVIEW_THRESHOLD=0.82
